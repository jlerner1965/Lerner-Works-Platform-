    "sections": [
     {
      "appearance": {
       "align": "start",
       "background": "default",
       "width": "default"
      },
      "body": [
       {
        "text": "Range Athletics is a fictional retailer created to demonstrate a multi-location business website. The stores, addresses, phone numbers and people on this site do not exist; the hours and services are realistic examples, not claims about any real business.",
        "type": "paragraph"
       },
       {
        "level": 2,
        "text": "What a real store site would do",
        "type": "heading"
       },
       {
        "items": [
         "Publish hours per store with date exceptions, and say so when hours are unknown",
         "List which services each store actually offers",
         "Route questions to the store that can answer them"
        ],
        "style": "bullet",
        "type": "list"
       },
       {
        "level": 2,
        "text": "What it deliberately does not do",
        "type": "heading"
       },
       {
        "text": "There is no inventory, no prices and no availability promise on this site. Those claims need a live connection to the stores' systems; without one, the honest choice is to let you ask.",
        "type": "paragraph"
       }
      ],
      "heading": "About Range Athletics",
      "id": "s-about",
      "type": "rich_text",
      "variant": "default"
     }
    ],
    "slug": "about",
    "sourceUrl": "",
    "summary": "What Range Athletics is, and what this demonstration site is and is not.",
    "title": "About"
   },
