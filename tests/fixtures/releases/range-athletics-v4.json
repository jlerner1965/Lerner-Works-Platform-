    "inquiryPrompt": "Want a fitting at a specific store or time? Ask and we will confirm availability.",
    "lastVerifiedOn": "",
    "metaDescription": "",
    "metaTitle": "",
    "schemaVersion": 1,
    "slug": "shoe-fitting",
    "sourceUrl": "",
    "summary": "A 20-minute fitting on the in-store treadmill with staff who look at how you land, not just what size you wear.",
    "title": "Run and hike shoe fitting"
   },
