      "variant": "default"
     },
     {
      "appearance": {
       "align": "start",
       "background": "default",
       "width": "default"
      },
      "heading": "Before you ask",
      "id": "s-faq",
      "items": [
       {
        "answer": [
         {
          "text": "Not from this site: there is no live inventory here. Send the store a question with the model and size and the floor staff will check the shelf and answer.",
          "type": "paragraph"
         }
        ],
        "question": "Can you tell me whether a size is in stock?"
       },
       {
        "answer": [
         {
          "text": "Same day if you drop off before noon at Boulder or Longmont, otherwise next day. Race tunes and base repairs are quoted in the store.",
          "type": "paragraph"
         }
        ],
        "question": "How long does a ski tune take?"
       },
       {
        "answer": [
         {
          "text": "No. Everything is collected in a store; that is how the fitting and tuning services stay honest.",
          "type": "paragraph"
         }
        ],
        "question": "Do you ship?"
       }
      ],
      "type": "faq",
      "variant": "default"
     },
     {
      "address": {
       "approved": false,
       "line1": "4100 Foothills Way",
       "line2": "Suite 200",
       "locality": "Longmont",
       "postalCode": "80501",
       "region": "CO"
      },
      "appearance": {
       "align": "start",
       "background": "default",
       "width": "default"
      },
      "heading": "Head office",
      "id": "s-office",
      "label": "Get directions",
      "provider": "google",
      "text": "Range Athletics Inc. is run from the Longmont store's upper floor. Deliveries and team orders go here.",
      "type": "map_link",
      "variant": "card"
     }
