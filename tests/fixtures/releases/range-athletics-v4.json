  "ce882a51-7436-4a53-b732-f426f88641c9": {
   "id": "ce882a51-7436-4a53-b732-f426f88641c9",
   "kind": "service",
   "payload": {
    "attribution": "",
    "body": [
     {
      "text": "Bring the socks you actually run or hike in, and the insoles if you use them. Staff watch you walk and jog, measure both feet, and pull three or four options before you try anything on. There is no charge for the fitting and no obligation to buy.",
      "type": "paragraph"
     },
     {
      "items": [
       "Book ahead on weekends",
       "Wide and narrow sizes stocked in Longmont",
       "Trail and road shoes, hiking boots"
      ],
      "style": "bullet",
      "type": "list"
     }
    ],
    "featuredImageAssetId": "f2abbc5b-ce88-4914-a029-5135907de1d1",
