# Copy to .env for local development. `pnpm db:start` fills the database entries
# and SESSION_SECRET automatically when they are missing. Never commit .env.

# local | staging | production. Seeds, the local auth provider and the local
# storage/notification sinks refuse to run unless APP_ENV=local.
APP_ENV=local

# Public origin of the application (used for absolute links and origin checks).
APP_URL=http://localhost:3000
# Host that serves the dashboard. Any other host is resolved through the domain registry.
APP_HOST=localhost:3000

# Ordinary request connection: a non-privileged login role that can only SET ROLE to
# anon/authenticated. Every query runs under row-level security with the user's identity.
DATABASE_URL=postgres://lw_app:CHANGE_ME@127.0.0.1:5432/lernerworks_dev
# Elevated connection used only by migrations, seeds, the delivery worker and the
# narrowly scoped server-only elevated module. Never exposed to request code paths.
DATABASE_ADMIN_URL=postgres://lw_admin:CHANGE_ME@127.0.0.1:5432/lernerworks_dev
# Isolated test database. Integration tests reset this database; its name must end in _test.
DATABASE_TEST_URL=postgres://lw_app:CHANGE_ME@127.0.0.1:5432/lernerworks_test
DATABASE_TEST_ADMIN_URL=postgres://lw_admin:CHANGE_ME@127.0.0.1:5432/lernerworks_test

# local (development-only password + database sessions) | supabase (hosted Supabase Auth)
AUTH_PROVIDER=local
# Random secret for signing local session cookies. Generated by `pnpm db:start`.
SESSION_SECRET=CHANGE_ME

# local (files under STORAGE_LOCAL_DIR) | supabase (Supabase Storage buckets)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/storage

# local-sink (writes notifications to NOTIFY_LOCAL_DIR; proves job processing only) |
# resend (hosted transactional email; requires NOTIFY_RESEND_API_KEY)
NOTIFY_PROVIDER=local-sink
NOTIFY_LOCAL_DIR=.data/mail
NOTIFY_FROM_ADDRESS=notifications@platform.example

# Hosted Supabase project (only when AUTH_PROVIDER/STORAGE_PROVIDER=supabase).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Chromium binary for Playwright when the exact browser revision is not installed.
# CHROMIUM_EXECUTABLE_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
