# Copy to .env for local development. `pnpm db:start` fills the database entries
# and SESSION_SECRET automatically when they are missing. Never commit .env.
# Hosted environments set these values in the hosting provider's secret store instead;
# docs/LAUNCH-CHECKLIST.md lists which ones staging and production require.

# local | staging | production. Seeds, the local auth provider and the local
# storage/notification sinks refuse to run unless APP_ENV=local. Outside local, the
# configuration check requires the hosted providers, https and the job secret.
APP_ENV=local

# Public origin of the application (used for absolute links and origin checks).
APP_URL=http://localhost:3000
# Host that serves the dashboard. Any other host is resolved through the domain registry.
APP_HOST=localhost:3000
# Uploaded sites (B7) are previewed at http(s)://<site key>.<PREVIEW_DOMAIN>/ on a hostname of
# their own, never on the dashboard's. Locally it defaults to preview.localhost (browsers resolve
# *.localhost to this machine); hosted, set a wildcard hostname under the platform domain.
# PREVIEW_DOMAIN=preview.localhost

# Ordinary request connection: a non-privileged login role that can only SET ROLE to
# anon/authenticated. Every query runs under row-level security with the user's identity.
# Hosted: the lw_app role created by supabase/hosted/0001_application_roles.sql.
DATABASE_URL=postgres://lw_app:CHANGE_ME@127.0.0.1:5432/lernerworks_dev
# Elevated connection used only by migrations, seeds, the delivery worker, the scheduled
# job endpoints and the narrowly scoped server-only elevated module. Hosted: the project's
# postgres role. Required outside APP_ENV=local.
DATABASE_ADMIN_URL=postgres://lw_admin:CHANGE_ME@127.0.0.1:5432/lernerworks_dev
# Isolated test database. Integration tests reset this database; its name must end in _test.
DATABASE_TEST_URL=postgres://lw_app:CHANGE_ME@127.0.0.1:5432/lernerworks_test
DATABASE_TEST_ADMIN_URL=postgres://lw_admin:CHANGE_ME@127.0.0.1:5432/lernerworks_test

# local (development-only password + database sessions) | supabase (hosted Supabase Auth;
# credentials are verified by GoTrue, the platform then issues its own httpOnly session).
AUTH_PROVIDER=local
# Random secret for signing local session cookies. Generated by `pnpm db:start`.
SESSION_SECRET=CHANGE_ME
# Lifetime of hosted sessions in days (1-30).
SESSION_DAYS=14

# local (files under STORAGE_LOCAL_DIR) | supabase (Supabase Storage buckets)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/storage

# local-sink (writes notifications to NOTIFY_LOCAL_DIR; proves job processing only) |
# resend (hosted transactional email; requires NOTIFY_RESEND_API_KEY and a sending domain
# verified at the provider for NOTIFY_FROM_ADDRESS)
NOTIFY_PROVIDER=local-sink
NOTIFY_LOCAL_DIR=.data/mail
NOTIFY_FROM_ADDRESS=notifications@platform.example
NOTIFY_RESEND_API_KEY=

# Hosted Supabase project (when AUTH_PROVIDER/STORAGE_PROVIDER=supabase).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Storage buckets: a private bucket for originals/derivatives and a public bucket for
# immutable published derivatives. Created by the owner in the Supabase dashboard.
SUPABASE_STORAGE_PRIVATE_BUCKET=private
SUPABASE_STORAGE_PUBLIC_BUCKET=public-assets

# Scheduled job endpoints (/api/jobs/deliver, /api/jobs/retention): bearer secret of at
# least 32 characters. Vercel Cron sends CRON_SECRET automatically; either name works.
# Required outside APP_ENV=local.
JOB_TRIGGER_SECRET=

# Hosting provider for customer domains. With these set, the dashboard registers hostnames
# on the Vercel project, shows the provider's own verification records and checks status.
# Without them, domains stay "pending" and cannot be verified from the dashboard.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Optional: Chromium binary for Playwright when the exact browser revision is not installed.
# CHROMIUM_EXECUTABLE_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
